# Порты публикации. Backend намеренно только на localhost (доступ через frontend-прокси).
BACKEND_PORT=18080
FRONTEND_PORT=18081
POSTGRES_PORT=18400

# Секреты. Сгенерировать при первом деплое (см. scripts/deploy.sh, он сделает это сам).
# APP_SECRET_KEY:    openssl rand -hex 32
# POSTGRES_PASSWORD: openssl rand -hex 16
# ENCRYPTION_KEY:    python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
APP_SECRET_KEY=change-me-openssl-rand-hex-32
POSTGRES_PASSWORD=change-me-openssl-rand-hex-16
ENCRYPTION_KEY=change-me-base64-32-bytes

# LLM (чат). Эмбеддинги вынесены в отдельный сервис Ollama.
LLM_API_KEY=sk-...
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL_CHAT=deepseek-v4-flash
LLM_MODEL_EMBEDDING=nomic-embed-text
LLM_EMBEDDING_DIMENSIONS=768

# Адрес внешнего сервиса эмбеддингов (репозиторий tp-20260831-tender-ollama).
# Локальный вариант: http://ollama:11434 (нужно раскомментировать сервис в docker-compose.yml)
EMBEDDING_SERVICE_URL=http://127.0.0.1:11434

# Поиск поставщиков (замена Google CSE).
SEARCH_API_URL=https://2222.apitter.com/search/api.php

# Почта: SMTP для отправки, IMAP для приёма ответов.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=robot@example.ru
SMTP_PASSWORD=change-me
SMTP_USE_TLS=false
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_USER=robot@example.ru
IMAP_PASSWORD=change-me
